EDITION=community

ANLYON_PUBLIC_URL=http://localhost:8080
SITE_ADDRESS=:80
ANLYON_PORT=8080
ANLYON_HTTPS_PORT=8443
ANLYON_BIND=127.0.0.1

ANLYON_ROOT_KEY=<generated by the installer>

ANLYON_SETUP_TOKEN=<generated by the installer>

POSTGRES_PASSWORD=<generated by the installer>
DATABASE_URL=postgresql://anlyon:<the same password>@postgres:5432/anlyon
REDIS_URL=redis://redis:6379
