{
  "name": "anlyon-scheduler",
  "license": "Elastic-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit --project tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "db:generate": "tsx scripts/db-generate.ts",
    "db:migrate": "node dist/db/migrate.js",
    "db:migrate:dev": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:setup-partitions": "tsx src/scripts/setup-log-partitions.ts",
    "db:setup-partitions:prod": "node dist/scripts/setup-log-partitions.js",
    "db:setup-pgvector": "tsx src/scripts/setup-pgvector.ts",
    "db:setup-pgvector:prod": "node dist/scripts/setup-pgvector.js",
    "db:deploy": "tsx src/scripts/setup-pgvector.ts && tsx src/db/migrate.ts && tsx src/scripts/setup-log-partitions.ts && tsx src/scripts/encrypt-sso-secrets.ts --apply",
    "db:deploy:prod": "node dist/scripts/setup-pgvector.js && node dist/db/migrate.js && node dist/scripts/setup-log-partitions.js && node dist/scripts/encrypt-sso-secrets.js --apply",
    "seed:demo": "tsx src/scripts/seed-demo-data.ts",
    "seed:fake": "tsx scripts/seed-fake-data.ts",
    "secrets:reencrypt": "tsx src/scripts/reencrypt-secret-envelopes.ts",
    "secrets:reencrypt:prod": "node dist/scripts/reencrypt-secret-envelopes.js",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "admin:create:prod": "node dist/scripts/create-admin.js",
    "api:openapi:edition": "tsx scripts/openapi-edition.ts",
    "audit:set-retention": "tsx scripts/set-audit-retention.ts",
    "sso:encrypt-secrets": "tsx src/scripts/encrypt-sso-secrets.ts",
    "audit:backfill": "tsx src/scripts/backfill-audit-events.ts",
    "audit:backfill:prod": "node dist/scripts/backfill-audit-events.js",
    "api:contract:report": "tsx scripts/api-contract.ts report",
    "api:contract:check": "tsx scripts/api-contract.ts check && tsx scripts/openapi-quality.ts check",
    "db:check:journal": "tsx scripts/migrations-journal.ts",
    "test:db:migrate": "tsx scripts/test-db-migrate.ts",
    "report:lifecycle-order": "tsx scripts/report-lifecycle-order.ts",
    "api:contract:examples": "tsx scripts/openapi-quality.ts generate",
    "api:contract:quality": "tsx scripts/openapi-quality.ts report",
    "api:contract:compat": "tsx scripts/openapi-compatibility.ts"
  },
  "dependencies": {
    "@anlyon-dev/risk": "workspace:*",
    "@anlyon/feature-flags": "workspace:*",
    "@anlyon/known-vendors": "workspace:*",
    "@anlyonhq/mcp-server": "workspace:*",
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/s3-request-presigner": "^3.980.0",
    "@better-auth/oauth-provider": "1.7.14",
    "@better-auth/sso": "1.7.14",
    "@cfworker/json-schema": "4.1.4",
    "@hono/node-server": "^1.19.18",
    "@marcbachmann/cel-js": "8.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/node": "^10.32.1",
    "@sentry/profiling-node": "^10.32.1",
    "acorn": "8.17.0",
    "bcryptjs": "^2.4.3",
    "better-auth": "1.7.14",
    "cron-parser": "^5.4.0",
    "date-fns": "^3.3.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.16",
    "ioredis": "^5.8.2",
    "jose": "^6.2.3",
    "nanoid": "^5.0.4",
    "nodemailer": "^10.0.16",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^10.3.1",
    "resend": "^6.5.2",
    "tree-sitter-python": "0.25.0",
    "undici": "^6.28.1",
    "web-tree-sitter": "0.25.10",
    "ws": "^8.18.3",
    "yaml": "^2.9.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.17",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "drizzle-kit": "^0.31.8",
    "ioredis-mock": "^8.13.1",
    "tsup": "^8.5.1",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  },
  "private": true
}
