{
  "needs": {
    "owner": "The account or organization that owns a test repository the token can reach (Issues, Pull requests and Contents granted on it)",
    "repo": "That test repository's name. It needs a README.md on its default branch",
    "base_branch": "A scratch branch in the test repository that is NOT the default branch. The run merges a pull request into it",
    "head_branch": "A branch with at least one commit that base_branch does not have. The run merges it into base_branch (squash), so create a fresh one for each run",
    "reviewer_login": "The login of a collaborator on the test repository other than the token's owner (GitHub refuses a review request to the pull request's author)"
  },
  "steps": [
    { "action": "get-repository", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}" } },
    { "action": "list-branches", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}" } },
    { "action": "list-commits", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}" } },
    { "action": "get-file-contents", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "path": "README.md" } },
    { "action": "search-code", "input": { "q": "README repo:{{needs.owner}}/{{needs.repo}}" } },
    { "action": "list-labels", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}" } },
    { "action": "create-label", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "name": "anlyon-exercise-{{run}}", "color": "5319e7", "description": "Created by an Anlyon exercise run; deleted at its end" }, "save": { "label_name": "name" } },
    { "action": "create-issue", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "title": "Anlyon exercise {{run}}", "body": "Opened by an Anlyon exercise run. It is closed at the end of the run." }, "save": { "issue_number": "number", "me": "user.login" } },
    { "action": "get-issue", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "issue_number": "{{saved.issue_number}}" } },
    { "action": "update-issue", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "issue_number": "{{saved.issue_number}}", "title": "Anlyon exercise {{run}} (edited)", "body": "Edited by the Anlyon exercise run." } },
    { "action": "add-labels", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "issue_number": "{{saved.issue_number}}", "labels": ["{{saved.label_name}}"] } },
    { "action": "remove-label", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "issue_number": "{{saved.issue_number}}", "name": "{{saved.label_name}}" } },
    { "action": "add-assignees", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "issue_number": "{{saved.issue_number}}", "assignees": ["{{saved.me}}"] } },
    { "action": "comment-on-issue", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "issue_number": "{{saved.issue_number}}", "body": "Anlyon exercise {{run}}: first comment." }, "save": { "comment_id": "id" } },
    { "action": "list-issue-comments", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "issue_number": "{{saved.issue_number}}" } },
    { "action": "update-comment", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "comment_id": "{{saved.comment_id}}", "body": "Anlyon exercise {{run}}: comment edited." } },
    { "action": "delete-comment", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "comment_id": "{{saved.comment_id}}" } },
    { "action": "list-issues", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "state": "open", "sort": "updated" } },
    { "action": "search-issues", "input": { "q": "repo:{{needs.owner}}/{{needs.repo}} is:issue Anlyon exercise" } },
    { "action": "close-issue", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "issue_number": "{{saved.issue_number}}" } },
    { "action": "reopen-issue", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "issue_number": "{{saved.issue_number}}" } },
    { "action": "update-issue", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "issue_number": "{{saved.issue_number}}", "state": "closed", "state_reason": "not_planned" } },
    { "action": "delete-label", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "name": "{{saved.label_name}}" } },
    { "action": "create-pull-request", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "title": "Anlyon exercise {{run}}", "head": "{{needs.head_branch}}", "base": "{{needs.base_branch}}", "body": "Opened by an Anlyon exercise run. It is merged into the scratch base branch at the end of the run." }, "save": { "pull_number": "number", "head_sha": "head.sha" } },
    { "action": "get-pull-request", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "pull_number": "{{saved.pull_number}}" } },
    { "action": "list-pull-requests", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "state": "open", "base": "{{needs.base_branch}}" } },
    { "action": "list-pull-request-files", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "pull_number": "{{saved.pull_number}}" } },
    { "action": "comment-on-pull-request", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "pull_number": "{{saved.pull_number}}", "body": "Anlyon exercise {{run}}: pull request comment." } },
    { "action": "create-review", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "pull_number": "{{saved.pull_number}}", "event": "COMMENT", "body": "Anlyon exercise {{run}}: review comment." } },
    { "action": "list-reviews", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "pull_number": "{{saved.pull_number}}" } },
    { "action": "list-review-comments", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "pull_number": "{{saved.pull_number}}" } },
    { "action": "request-reviewers", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "pull_number": "{{saved.pull_number}}", "reviewers": ["{{needs.reviewer_login}}"] } },
    { "action": "merge-pull-request", "input": { "owner": "{{needs.owner}}", "repo": "{{needs.repo}}", "pull_number": "{{saved.pull_number}}", "sha": "{{saved.head_sha}}", "merge_method": "squash" } }
  ]
}
