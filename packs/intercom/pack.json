          "contact_id"
        ],
        "additionalProperties": false,
        "properties": {
          "contact_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$",
            "description": "The contact's Intercom id (24 hex characters)."
          }
        }
      },
      "requiresApproval": false,
      "impact": {
        "dimension": "resource_mutations",
        "amount": "1",
        "bound": "exact"
      }
