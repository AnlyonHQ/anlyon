    {
      "name": "create-conversation",
      "kind": "write",
      "description": "Start a conversation as a message from a contact (a lead or a user), for example to record a request that came in by phone. Read back from the new conversation; its contact must be this contact. Limitations: no provider idempotency, so a retry after an unknown outcome can create a second conversation; workflows or Fin may answer it as they would any inbound message.",
      "method": "POST",
      "urlTemplate": "https://api.intercom.io/conversations",
      "headers": {
        "Authorization": "Bearer {{connection:intercom}}",
        "Accept": "application/json",
        "Intercom-Version": "2.11",
        "Content-Type": "application/json"
      },
      "bodyTemplate": {
        "from": {
          "type": "{{input.from_type}}",
          "id": "{{input.contact_id}}"
        },
        "body": "{{input.body}}"
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "from_type",
          "contact_id",
          "body"
        ],
        "additionalProperties": false,
        "properties": {
          "from_type": {
            "type": "string",
            "enum": [
              "lead",
              "user"
            ],
            "description": "The contact's role."
          },
          "contact_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$",
            "description": "The contact's Intercom id (24 hex characters)."
          },
          "body": {
            "type": "string",
            "pattern": "^[\\s\\S]{1,10000}$",
            "description": "The message, plain text (HTML is not supported)."
          }
        }
      },
      "requiresApproval": false,
      "impact": {
        "dimension": "resource_mutations",
        "amount": "1",
        "bound": "exact"
      },
      "verify": {
        "url": "https://api.intercom.io/conversations/{{response.conversation_id}}",
        "status": 200,
        "match": [
          {
            "path": "contacts.contacts.0.id",
            "equals": "{{input.contact_id}}"
          }
        ]
      }
    },
