    {
      "name": "delete-contact",
      "kind": "write",
      "description": "Permanently delete one contact. No read-back: Intercom documents no answer for reading a deleted contact, so the receipt rests on the delete response (deleted: true). It cannot be undone.",
      "method": "DELETE",
      "urlTemplate": "https://api.intercom.io/contacts/{{input.contact_id}}",
      "headers": {
        "Authorization": "Bearer {{connection:intercom}}",
