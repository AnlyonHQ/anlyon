    {
      "name": "create-maintenance-window",
      "description": "Create a maintenance window on one service: between start_time and end_time PagerDuty opens no incidents on it, so nobody is paged for it. Read back by the window's id; its description and service must match. Limitation: no provider idempotency, so a retry after an unknown outcome can create a second window.",
      "kind": "write",
      "method": "POST",
      "urlTemplate": "https://api.pagerduty.com/maintenance_windows",
      "headers": {
        "Authorization": "Token token={{connection:pagerduty}}",
        "Accept": "application/vnd.pagerduty+json;version=2",
        "From": "{{input.from}}",
        "Content-Type": "application/json"
      },
      "bodyTemplate": {
        "maintenance_window": {
          "type": "maintenance_window",
          "start_time": "{{input.start_time}}",
          "end_time": "{{input.end_time}}",
          "description": "{{input.description}}",
          "services": [
            {
              "id": "{{input.service_id}}",
              "type": "service_reference"
            }
          ]
        }
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "from",
          "service_id",
          "start_time",
          "end_time",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[^@\\s]{1,64}@[^@\\s]{1,190}$",
            "description": "Email address of a PagerDuty user in the account; PagerDuty records the change as made by them."
          },
          "service_id": {
            "type": "string",
            "pattern": "^[A-Z0-9]{5,20}$",
            "description": "The service to put in maintenance."
          },
          "start_time": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:[0-9]{2})$",
            "description": "When the window starts, ISO 8601 with a time zone, such as 2026-10-16T22:00:00Z."
          },
          "end_time": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:[0-9]{2})$",
            "description": "When the window ends, ISO 8601 with a time zone; after start_time."
          },
          "description": {
            "type": "string",
            "pattern": "^[^\\n]{1,255}$",
            "description": "Why the service is in maintenance."
          }
        }
      },
      "requiresApproval": false,
      "impact": {
        "dimension": "resource_mutations",
        "amount": "1",
        "bound": "exact"
      },
