        "match": [
          {
            "path": "maintenance_window.description",
            "equals": "{{input.description}}"
          },
          {
            "path": "maintenance_window.services.0.id",
            "equals": "{{input.service_id}}"
          }
        ]
      }
    },
    {
      "name": "end-maintenance-window",
