    {
      "name": "snooze-incident",
      "description": "Snooze one acknowledged incident for a fixed time, after which it returns to triggered and notifies again; PagerDuty refuses to snooze an incident that is not acknowledged. Read back from the incident; it must still be acknowledged. Limitation: the incident does not show the snooze length, so the read-back proves the status, not the duration.",
      "kind": "write",
      "method": "POST",
      "urlTemplate": "https://api.pagerduty.com/incidents/{{input.incident_id}}/snooze",
      "headers": {
        "Authorization": "Token token={{connection:pagerduty}}",
        "Accept": "application/vnd.pagerduty+json;version=2",
