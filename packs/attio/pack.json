    {
      "name": "create-task",
      "kind": "write",
      "description": "Create one open plain-text task with a deadline, linked to a person or company, optionally assigned to a workspace member by email address. Read back by task id; the content and the linked record must match. Limitation: no provider idempotency, so a retry after an unknown outcome can create a second task.",
      "method": "POST",
      "urlTemplate": "https://api.attio.com/v2/tasks",
      "headers": {
        "Authorization": "Bearer {{connection:attio}}",
        "Content-Type": "application/json"
      },
      "bodyTemplate": {
        "data": {
          "content": "{{input.content}}",
          "format": "plaintext",
          "deadline_at": "{{input.deadline_at}}",
          "is_completed": false,
          "linked_records": [
            {
              "target_object": "{{input.linked_object}}",
              "target_record_id": "{{input.linked_record_id}}"
            }
          ],
          "assignees": [
            "{{input.assignee}}"
          ]
        }
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "content",
          "deadline_at",
          "linked_object",
          "linked_record_id"
        ],
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string",
            "pattern": "^[\\s\\S]{1,2000}$"
          },
          "deadline_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,9})?)?(Z|[+-][0-9]{2}:[0-9]{2})$",
            "description": "ISO 8601 timestamp, e.g. 2026-10-20T17:00:00Z."
          },
          "linked_object": {
            "type": "string",
            "enum": [
              "people",
              "companies"
            ],
            "description": "The object: people or companies."
          },
          "linked_record_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "description": "The record the task is about."
          },
          "assignee": {
            "type": "object",
            "required": [
              "workspace_member_email_address"
            ],
            "additionalProperties": false,
            "properties": {
              "workspace_member_email_address": {
                "type": "string",
                "pattern": "^[^@\\s]{1,64}@[^@\\s]{1,190}$"
              }
            }
          }
        }
      },
      "requiresApproval": false,
      "impact": {
        "dimension": "resource_mutations",
        "amount": "1",
        "bound": "exact"
      },
      "verify": {
        "url": "https://api.attio.com/v2/tasks/{{response.data.id.task_id}}",
        "status": 200,
        "match": [
          {
            "path": "data.content_plaintext",
            "equals": "{{input.content}}"
          },
          {
            "path": "data.linked_records.0.target_record_id",
            "equals": "{{input.linked_record_id}}"
          }
        ]
      }
    },
