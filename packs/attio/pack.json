        "additionalProperties": false,
        "properties": {
          "list": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "description": "The list's api_slug or id (from list-lists). Its parent object must be the record's object."
          },
          "object": {
            "type": "string",
            "enum": [
              "people",
              "companies"
            ],
            "description": "The object: people or companies."
          },
          "record_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
