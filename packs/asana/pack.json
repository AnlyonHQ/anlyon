    {
      "name": "add-follower",
      "kind": "write",
      "description": "Add one follower (\"me\", a user gid or an email) to a task. A follower is notified of changes and can see the task even outside its projects. No read-back: a follower can be named as \"me\", a user gid or an email, while Asana lists followers by gid only, so a read-back cannot compare them.",
      "method": "POST",
      "urlTemplate": "https://app.asana.com/api/1.0/tasks/{{input.task_gid}}/addFollowers?opt_fields=followers.name",
      "headers": {
        "Authorization": "Bearer {{connection:asana}}",
        "Accept": "application/json",
        "Content-Type": "application/json"
      },
      "bodyTemplate": {
        "data": {
          "followers": [
            "{{input.follower}}"
          ]
        }
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "task_gid",
          "follower"
        ],
        "additionalProperties": false,
        "properties": {
          "task_gid": {
            "type": "string",
            "pattern": "^[0-9]{1,24}$"
          },
          "follower": {
            "type": "string",
            "pattern": "^(me|[0-9]{1,24}|[^@\\s]{1,64}@[^@\\s]{1,190})$"
          }
        }
      },
      "requiresApproval": false,
      "impact": {
        "dimension": "resource_mutations",
        "amount": "1",
        "bound": "exact"
      }
    },
