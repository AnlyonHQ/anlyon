{
  "needs": {
    "payment_intent_id": "A succeeded test-mode payment intent in the pack's currency (usd by default) with at least 1.00 still refundable. The run refunds 1.00 of it.",
    "draft_invoice_id": "A test-mode draft invoice made by hand for this run only, with collection method 'send invoice' and at least one line item. The run finalizes it and then voids it.",
    "subscription_id": "A test-mode subscription made by hand for this run only (a trial on a test customer is enough). The run sets it to cancel at period end, reverts that, then cancels it."
  },
  "steps": [
    {
      "action": "get-balance",
      "input": {}
    },
    {
      "action": "list-balance-transactions",
      "input": {}
    },
    {
      "action": "create-customer",
      "input": {
        "email": "anlyon-exercise-{{run}}@example.com",
        "name": "Anlyon exercise {{run}}",
        "metadata": {
          "anlyon_run": "{{run}}"
        }
      },
      "save": {
        "customer_id": "id"
      }
    },
    {
      "action": "get-customer",
      "input": {
        "customer_id": "{{saved.customer_id}}"
      }
    },
    {
      "action": "update-customer",
      "input": {
        "customer_id": "{{saved.customer_id}}",
        "name": "Anlyon exercise {{run}} (updated)",
        "description": "Created by anlyon packs exercise"
      }
    },
    {
      "action": "list-customers",
      "input": {
        "email": "anlyon-exercise-{{run}}@example.com"
      }
    },
    {
      "action": "search-customers",
      "input": {
        "query": "email:'anlyon-exercise-{{run}}@example.com'"
      }
    },
    {
      "action": "list-payment-intents",
      "input": {}
    },
    {
      "action": "get-payment-intent",
      "input": {
        "payment_intent_id": "{{needs.payment_intent_id}}"
      }
    },
    {
      "action": "list-charges",
      "input": {
        "payment_intent": "{{needs.payment_intent_id}}"
      },
      "save": {
        "charge_id": "data.0.id"
      }
    },
    {
      "action": "get-charge",
      "input": {
        "charge_id": "{{saved.charge_id}}"
      }
    },
    {
      "action": "refund-payment",
      "input": {
        "paymentIntent": "{{needs.payment_intent_id}}",
        "amount": 100,
        "currency": "usd",
        "reason": "requested_by_customer"
      }
    },
    {
      "action": "list-refunds",
      "input": {
        "payment_intent": "{{needs.payment_intent_id}}"
      },
      "save": {
        "refund_id": "data.0.id"
      }
    },
    {
      "action": "get-refund",
      "input": {
        "refund_id": "{{saved.refund_id}}"
      }
    },
    {
      "action": "get-invoice",
      "input": {
        "invoice_id": "{{needs.draft_invoice_id}}"
      }
    },
    {
      "action": "finalize-invoice",
      "input": {
        "invoice_id": "{{needs.draft_invoice_id}}"
      }
    },
    {
      "action": "list-invoices",
      "input": {
        "status": "open"
      }
    },
    {
      "action": "void-invoice",
      "input": {
        "invoice_id": "{{needs.draft_invoice_id}}"
      }
    },
    {
      "action": "list-subscriptions",
      "input": {
        "status": "all"
      }
    },
    {
      "action": "get-subscription",
      "input": {
        "subscription_id": "{{needs.subscription_id}}"
      }
    },
    {
      "action": "set-subscription-cancel-at-period-end",
      "input": {
        "subscription_id": "{{needs.subscription_id}}",
        "cancel_at_period_end": true
      }
    },
    {
      "action": "set-subscription-cancel-at-period-end",
      "input": {
        "subscription_id": "{{needs.subscription_id}}",
        "cancel_at_period_end": false
      }
    },
    {
      "action": "cancel-subscription",
      "input": {
        "subscription_id": "{{needs.subscription_id}}",
        "comment": "anlyon packs exercise {{run}}"
      }
    },
    {
      "action": "delete-customer",
      "input": {
        "customer_id": "{{saved.customer_id}}"
      }
    }
  ]
}
