  "policies": [
    {
      "name": "sendgrid: approve an email to more than 5 recipients",
      "matchKind": "action",
      "matchActionName": "send-email",
      "condition": "size(input.to) > 5",
      "effect": "require_approval"
    },
    {
      "name": "sendgrid: approve a template email to more than 5 recipients",
      "matchKind": "action",
      "matchActionName": "send-template-email",
      "condition": "size(input.to) > 5",
      "effect": "require_approval"
    },
    {
      "name": "sendgrid: approve deleting a contact",
      "matchKind": "action",
      "matchActionName": "delete-contact",
      "effect": "require_approval"
    },
    {
      "name": "sendgrid: approve deleting a list",
      "matchKind": "action",
      "matchActionName": "delete-list",
      "effect": "require_approval"
    },
    {
      "name": "sendgrid: approve subscribing an address to a group again",
      "matchKind": "action",
      "matchActionName": "remove-from-unsubscribe-group",
      "effect": "require_approval"
    },
    {
      "name": "sendgrid: approve taking an address off the global unsubscribe list",
      "matchKind": "action",
      "matchActionName": "remove-global-unsubscribe",
      "effect": "require_approval"
    }
  ],
