          "email": {
            "type": "string",
            "pattern": "^[^@\\sA-Z/?#]{1,64}@[^@\\sA-Z/?#]{1,190}$",
            "description": "The address to check. Lower case: SendGrid stores addresses that way."
          }
        }
      }
    }
